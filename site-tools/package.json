{
  "name": "@vulnpilot/site-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Build, proof capture and tests for the Vulnpilot website in site/. Not published.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsx build/index.ts",
    "check": "tsx checks/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scanner.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "serve": "tsx server/serve.ts",
    "capture-proof": "node scripts/capture-proof.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "html-validate": "^11.21.1",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
